<!DOCTYPE html>
<html>
  <head>
    <title>Netra Admin</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= javascript_importmap_tags %>
    <style>
      :root {
        --bg: #f5efe4;
        --paper: rgba(255, 250, 243, 0.92);
        --paper-strong: #fffaf3;
        --ink: #1f1b16;
        --muted: #6d6459;
        --line: rgba(58, 43, 26, 0.14);
        --accent: #b24c2f;
        --accent-deep: #7d2d17;
        --accent-soft: #f1d1c8;
        --success: #316b44;
        --warning: #8a6120;
        --danger: #8a2e2e;
        --shadow: 0 24px 70px rgba(80, 50, 16, 0.12);
        --radius: 22px;
        --mono: "SFMono-Regular", "Cascadia Code", "JetBrains Mono", Consolas, monospace;
        --serif: "Iowan Old Style", "Palatino Linotype", "Book Antiqua", Georgia, serif;
      }

      * { box-sizing: border-box; }
      body {
        margin: 0;
        color: var(--ink);
        background:
          radial-gradient(circle at top left, rgba(178, 76, 47, 0.18), transparent 28%),
          radial-gradient(circle at right 20%, rgba(138, 97, 32, 0.16), transparent 24%),
          linear-gradient(180deg, #f8f2e8 0%, #f3ede3 100%);
        font-family: var(--serif);
      }

      a { color: inherit; text-decoration: none; }
      .shell { min-height: 100vh; display: grid; grid-template-columns: 320px 1fr; }
      .sidebar {
        padding: 28px 22px;
        background: rgba(34, 27, 20, 0.94);
        color: #f6efe4;
        position: sticky;
        top: 0;
        height: 100vh;
        overflow-y: auto;
      }
      .brand {
        margin-bottom: 28px;
        padding-bottom: 22px;
        border-bottom: 1px solid rgba(255,255,255,0.12);
      }
      .brand h1 {
        margin: 0 0 8px;
        font-size: 2rem;
        letter-spacing: 0.02em;
      }
      .brand p, .sidebar small { color: rgba(246, 239, 228, 0.72); }
      .sidebar-section { margin-bottom: 24px; }
      .sidebar-link {
        display: block;
        padding: 12px 14px;
        border-radius: 14px;
        margin-bottom: 8px;
        background: transparent;
        border: 1px solid transparent;
      }
      .sidebar-link:hover, .sidebar-link--active {
        background: rgba(255,255,255,0.08);
        border-color: rgba(255,255,255,0.12);
      }
      .sidebar-link strong { display: block; font-size: 1rem; }
      .sidebar-link span { display: block; font-size: 0.84rem; color: rgba(246, 239, 228, 0.66); }
      .main { padding: 26px; }
      .hero {
        background: var(--paper);
        backdrop-filter: blur(8px);
        border: 1px solid var(--line);
        border-radius: 28px;
        box-shadow: var(--shadow);
        padding: 28px;
        margin-bottom: 22px;
      }
      .hero h2 { margin: 0 0 10px; font-size: 2.2rem; }
      .hero p { margin: 0; color: var(--muted); max-width: 60ch; }
      .grid {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: 18px;
      }
      .card {
        grid-column: span 12;
        background: var(--paper);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        padding: 22px;
      }
      .card h3, .card h4 { margin: 0 0 12px; }
      .card p { color: var(--muted); }
      .card--half { grid-column: span 6; }
      .card--third { grid-column: span 4; }
      .card--quarter { grid-column: span 3; }
      .stack { display: grid; gap: 14px; }
      .row { display: flex; gap: 12px; flex-wrap: wrap; align-items: center; }
      .spread { display: flex; justify-content: space-between; gap: 12px; align-items: center; }
      .badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 7px 12px;
        border-radius: 999px;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        background: var(--accent-soft);
        color: var(--accent-deep);
      }
      .badge--active { background: rgba(49, 107, 68, 0.14); color: var(--success); }
      .badge--draft { background: rgba(138, 97, 32, 0.14); color: var(--warning); }
      .badge--archived { background: rgba(31, 27, 22, 0.08); color: var(--muted); }
      form { display: grid; gap: 12px; }
      label { display: grid; gap: 6px; font-size: 0.95rem; }
      input, textarea, select {
        width: 100%;
        border-radius: 14px;
        border: 1px solid rgba(58, 43, 26, 0.16);
        background: rgba(255,255,255,0.78);
        padding: 12px 14px;
        font: inherit;
        color: inherit;
      }
      textarea {
        min-height: 130px;
        resize: vertical;
        font-family: var(--mono);
        font-size: 0.9rem;
        line-height: 1.5;
      }
      .json-editor--invalid { outline: 2px solid rgba(178, 76, 47, 0.5); }
      .button, button {
        appearance: none;
        border: 0;
        border-radius: 999px;
        background: var(--accent);
        color: white;
        padding: 12px 18px;
        font: inherit;
        cursor: pointer;
      }
      .button--ghost {
        background: rgba(178, 76, 47, 0.08);
        color: var(--accent-deep);
      }
      .button--danger { background: var(--danger); }
      .button-inline { display: inline-flex; }
      .muted { color: var(--muted); }
      .metric {
        font-family: var(--mono);
        font-size: 2rem;
        margin: 0;
      }
      .microcopy {
        font-size: 0.84rem;
        color: var(--muted);
        line-height: 1.5;
      }
      .code {
        font-family: var(--mono);
        font-size: 0.88rem;
        background: rgba(31, 27, 22, 0.05);
        border-radius: 12px;
        padding: 2px 8px;
      }
      .flash {
        margin-bottom: 18px;
        padding: 14px 18px;
        border-radius: 18px;
        border: 1px solid var(--line);
        background: var(--paper-strong);
      }
      .flash--alert { border-color: rgba(138, 46, 46, 0.2); color: var(--danger); }
      .flash--notice { border-color: rgba(49, 107, 68, 0.18); color: var(--success); }
      .empty-state {
        padding: 32px;
        border-radius: 24px;
        border: 1px dashed rgba(58, 43, 26, 0.18);
        background: rgba(255,255,255,0.5);
      }
      .rule-list { display: grid; gap: 16px; }
      .rule-card {
        padding: 18px;
        border-radius: 18px;
        background: rgba(255,255,255,0.64);
        border: 1px solid rgba(58, 43, 26, 0.12);
      }
      .comparison-list {
        display: grid;
        gap: 10px;
      }
      .comparison-item {
        padding: 14px 16px;
        border-radius: 14px;
        background: rgba(255,255,255,0.6);
        border: 1px solid rgba(58, 43, 26, 0.08);
      }
      pre {
        margin: 0;
        white-space: pre-wrap;
        word-break: break-word;
        font-family: var(--mono);
        font-size: 0.88rem;
        line-height: 1.5;
      }
      .auth-shell {
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 24px;
      }
      .auth-card {
        width: min(520px, 100%);
        background: var(--paper);
        border: 1px solid var(--line);
        border-radius: 28px;
        box-shadow: var(--shadow);
        padding: 34px;
      }
      @media (max-width: 980px) {
        .shell { grid-template-columns: 1fr; }
        .sidebar {
          height: auto;
          position: static;
        }
        .card--half, .card--third, .card--quarter { grid-column: span 12; }
      }
    </style>
  </head>
  <body>
    <%= yield %>
  </body>
</html>
