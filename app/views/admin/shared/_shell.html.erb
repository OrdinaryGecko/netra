<div data-controller="sidebar">
<div class="shell" data-sidebar-target="shell">
  <aside class="sidebar">
    <div class="sidebar-toolbar">
      <span class="sidebar-heading">Workbench</span>
      <button type="button" class="button button-inline sidebar-toggle" data-sidebar-target="toggle" data-action="sidebar#toggle">Collapse</button>
    </div>
    <div class="brand">
      <h1>Netra</h1>
      <p>Policy workbench for guarded LLM traffic.</p>
      <small>
        Signed in as
        <span class="code"><%= current_admin_api_key.name %></span>
      </small>
    </div>

    <div class="sidebar-section">
      <div class="spread">
        <strong>Policy Sets</strong>
        <%= button_to "Sign out", admin_session_path, method: :delete, class: "button button--ghost button-inline" %>
      </div>
    </div>

    <div class="sidebar-section">
      <% if policy_sets.any? %>
        <% policy_sets.each do |policy_set| %>
          <%= link_to admin_policy_set_path(policy_set), class: "sidebar-link #{'sidebar-link--active' if selected_policy_set_id.to_s == policy_set.id.to_s}" do %>
            <strong><%= policy_set.name %></strong>
            <span><%= policy_set.environment %> · <%= pluralize(policy_set.policy_versions.size, "version") %></span>
          <% end %>
        <% end %>
      <% else %>
        <small>No policy sets yet.</small>
      <% end %>
    </div>
  </aside>

  <main class="main">
    <% flash.each do |type, message| %>
      <div class="flash flash--<%= type %>"><%= message %></div>
    <% end %>

    <%= yield %>
  </main>
</div>
</div>
