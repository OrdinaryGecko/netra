<%= render "admin/shared/shell" do %>
  <section class="hero">
    <div class="spread">
      <div>
        <p class="badge badge--<%= @policy_version.status %>"><%= @policy_version.status %></p>
        <h2><%= @policy_version.version %></h2>
        <p>
          Part of
          <%= link_to @policy_set.name, admin_policy_set_path(@policy_set), class: "code" %>
          in <span class="code"><%= @policy_set.environment %></span>.
        </p>
      </div>
      <div class="row">
        <% unless @policy_version.status == "active" %>
          <%= button_to "Publish", publish_admin_policy_version_path(@policy_version), method: :post, class: "button" %>
        <% end %>
      </div>
    </div>
  </section>

  <div class="grid">
    <section class="card card--quarter">
      <h3>Rules</h3>
      <p class="metric"><%= @policy_version.rules.size %></p>
      <p class="microcopy">Total rules in this version.</p>
    </section>

    <section class="card card--quarter">
      <h3>Input checks</h3>
      <p class="metric"><%= @policy_version.rules.count { |rule| rule.stage == "input" } %></p>
      <p class="microcopy">Pre-provider enforcement rules.</p>
    </section>

    <section class="card card--quarter">
      <h3>Output checks</h3>
      <p class="metric"><%= @policy_version.rules.count { |rule| rule.stage == "output" } %></p>
      <p class="microcopy">Post-provider response checks.</p>
    </section>

    <section class="card card--quarter">
      <h3>Blocking rules</h3>
      <p class="metric"><%= @policy_version.rules.count { |rule| rule.action == "block" } %></p>
      <p class="microcopy">Rules that stop traffic outright.</p>
    </section>

    <section class="card card--half">
      <h3>Version details</h3>
      <%= form_with model: [:admin, @policy_version], method: :patch, data: { controller: "json-editor" } do |form| %>
        <label>
          Version
          <%= form.text_field :version, disabled: @policy_version.status != "draft" %>
        </label>
        <label>
          Definition JSON
          <%= text_area_tag "policy_version[definition_json]", JSON.pretty_generate(@policy_version.definition), disabled: @policy_version.status != "draft", data: { json_editor_target: "input" } %>
        </label>
        <div class="row">
          <button type="button" class="button button--ghost" data-action="json-editor#format">Format JSON</button>
          <%= form.submit "Save version", disabled: @policy_version.status != "draft" %>
        </div>
      <% end %>
    </section>

    <section class="card card--half">
      <h3>Version comparison</h3>
      <% if @comparison.available? %>
        <p class="muted">
          Comparing against
          <span class="code"><%= @comparison.baseline_version.version %></span>
          (<%= @comparison.baseline_version.status %>).
        </p>

        <div class="grid">
          <div class="card--third">
            <p class="metric"><%= @comparison.added_rules.size %></p>
            <p class="microcopy">Added rules</p>
          </div>
          <div class="card--third">
            <p class="metric"><%= @comparison.changed_rules.size %></p>
            <p class="microcopy">Changed rules</p>
          </div>
          <div class="card--third">
            <p class="metric"><%= @comparison.removed_rules.size %></p>
            <p class="microcopy">Removed rules</p>
          </div>
        </div>

        <div class="comparison-list">
          <% @comparison.added_rules.first(4).each do |name| %>
            <div class="comparison-item">
              <strong>Added</strong>
              <div class="code"><%= name %></div>
            </div>
          <% end %>
          <% @comparison.changed_rules.first(4).each do |change| %>
            <div class="comparison-item">
              <strong>Changed</strong>
              <div class="code"><%= change[:name] %></div>
              <div class="microcopy">
                <%= change[:before][:action] %> → <%= change[:after][:action] %>,
                priority <%= change[:before][:priority] %> → <%= change[:after][:priority] %>
              </div>
            </div>
          <% end %>
          <% @comparison.removed_rules.first(4).each do |name| %>
            <div class="comparison-item">
              <strong>Removed</strong>
              <div class="code"><%= name %></div>
            </div>
          <% end %>

          <% if @comparison.total_changes.zero? %>
            <div class="comparison-item">
              <strong>No rule deltas</strong>
              <div class="microcopy">This version currently matches the comparison baseline.</div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="empty-state">
          <p>No comparison baseline yet. Create or publish another version to see deltas.</p>
        </div>
      <% end %>
    </section>

    <section class="card card--half">
      <h3>Clone into draft</h3>
      <%= form_with url: clone_admin_policy_version_path(@policy_version), method: :post, data: { controller: "json-editor" } do |form| %>
        <label>
          New version
          <%= form.text_field :version, name: "policy_version[version]", placeholder: "#{@policy_version.version}-draft" %>
        </label>
        <label>
          Definition JSON override
          <%= text_area_tag "policy_version[definition_json]", JSON.pretty_generate(@policy_version.definition), data: { json_editor_target: "input" } %>
        </label>
        <div class="row">
          <button type="button" class="button button--ghost" data-action="json-editor#format">Format JSON</button>
          <%= form.submit "Clone draft" %>
        </div>
      <% end %>
    </section>

    <section class="card">
      <div class="spread">
        <h3>Rules</h3>
        <span class="muted"><%= pluralize(@policy_version.rules.size, "rule") %></span>
      </div>

      <div class="rule-list">
        <% @policy_version.rules.each do |rule| %>
          <div class="rule-card">
            <%= form_with model: rule, scope: :rule, url: admin_rule_path(rule), method: :patch, data: { controller: "json-editor rule-form" } do |form| %>
              <div class="grid">
                <div class="card--third">
                  <label>
                    Name
                    <%= form.text_field :name, disabled: @policy_version.status != "draft" %>
                  </label>
                </div>
                <div class="card--third">
                  <label>
                    Kind
                    <%= form.select :kind, options_for_select(Rule::KINDS.map { |kind| [kind.humanize, kind] }, rule.kind), {}, disabled: @policy_version.status != "draft", data: { rule_form_target: "kind", action: "rule-form#kindChanged" } %>
                  </label>
                </div>
                <div class="card--third">
                  <label>
                    Stage
                    <%= form.select :stage, options_for_select(Rule::STAGES.map { |stage| [stage.humanize, stage] }, rule.stage), {}, disabled: @policy_version.status != "draft" %>
                  </label>
                </div>
                <div class="card--third">
                  <label>
                    Action
                    <%= form.select :action, options_for_select(Rule::ACTIONS.map { |action| [action.humanize, action] }, rule.action), {}, disabled: @policy_version.status != "draft" %>
                  </label>
                </div>
                <div class="card--third">
                  <label>
                    Priority
                    <%= form.number_field :priority, disabled: @policy_version.status != "draft" %>
                  </label>
                </div>
                <div class="card--third">
                  <label class="checkbox-row">
                    <%= form.check_box :enabled, disabled: @policy_version.status != "draft" %>
                    Enabled
                  </label>
                </div>
              </div>

              <label>
                Config JSON
                <%= text_area_tag "rule[config_json]", JSON.pretty_generate(rule.config), disabled: @policy_version.status != "draft", data: { json_editor_target: "input", rule_form_target: "config" } %>
              </label>
              <p class="microcopy" data-rule-form-target="summary"></p>

              <div class="row">
                <button type="button" class="button button--ghost" data-action="json-editor#format">Format JSON</button>
                <button type="button" class="button button--ghost" data-action="rule-form#applyTemplate" <%= "disabled" if @policy_version.status != "draft" %>>Use template</button>
                <%= form.submit "Save rule", disabled: @policy_version.status != "draft" %>
                <% if @policy_version.status == "draft" %>
                  <%= link_to "Delete", admin_rule_path(rule), class: "button button--danger", data: { turbo_method: :delete, turbo_confirm: "Delete this rule?" } %>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </section>

    <section class="card card--half">
      <h3>Add rule</h3>
      <%= form_with url: admin_rules_path, method: :post, data: { controller: "json-editor rule-form" } do |form| %>
        <%= hidden_field_tag "rule[policy_version_id]", @policy_version.id %>
        <label>
          Name
          <%= form.text_field :name, name: "rule[name]", placeholder: "block-sensitive-topics", disabled: @policy_version.status != "draft" %>
        </label>
        <div class="grid">
          <div class="card--third">
            <label>
              Kind
              <%= select_tag "rule[kind]", options_for_select(Rule::KINDS.map { |kind| [kind.humanize, kind] }), disabled: @policy_version.status != "draft", data: { rule_form_target: "kind", action: "rule-form#kindChanged" } %>
            </label>
          </div>
          <div class="card--third">
            <label>
              Stage
              <%= select_tag "rule[stage]", options_for_select(Rule::STAGES.map { |stage| [stage.humanize, stage] }), disabled: @policy_version.status != "draft" %>
            </label>
          </div>
          <div class="card--third">
            <label>
              Action
              <%= select_tag "rule[action]", options_for_select(Rule::ACTIONS.map { |action| [action.humanize, action] }), disabled: @policy_version.status != "draft" %>
            </label>
          </div>
        </div>
        <label>
          Priority
          <%= number_field_tag "rule[priority]", 100, disabled: @policy_version.status != "draft" %>
        </label>
        <label class="checkbox-row">
          <%= check_box_tag "rule[enabled]", true, true, disabled: @policy_version.status != "draft" %>
          Enabled
        </label>
        <label>
          Config JSON
          <%= text_area_tag "rule[config_json]", JSON.pretty_generate(max: 4000), disabled: @policy_version.status != "draft", data: { json_editor_target: "input", rule_form_target: "config" } %>
        </label>
        <p class="microcopy" data-rule-form-target="summary"></p>
        <div class="row">
          <button type="button" class="button button--ghost" data-action="json-editor#format">Format JSON</button>
          <button type="button" class="button button--ghost" data-action="rule-form#applyTemplate" <%= "disabled" if @policy_version.status != "draft" %>>Use template</button>
          <%= form.submit "Create rule", disabled: @policy_version.status != "draft" %>
        </div>
      <% end %>
    </section>

    <section class="card card--half">
      <h3>Dry run policy version</h3>
      <%= form_with url: dry_run_admin_policy_version_path(@policy_version), method: :post, data: { turbo_frame: "dry_run_result", controller: "json-editor rule-form" } do %>
        <div class="row">
          <button type="button" class="button button--ghost" data-action="rule-form#loadSafePayload">Safe JSON</button>
          <button type="button" class="button button--ghost" data-action="rule-form#loadInjectionPayload">Injection attempt</button>
          <button type="button" class="button button--ghost" data-action="rule-form#loadPiiPayload">PII output</button>
        </div>
        <label>
          Request payload JSON
          <%= text_area_tag "dry_run[payload_json]", @dry_run_payload, data: { json_editor_target: "input", rule_form_target: "config" } %>
        </label>
        <div class="row">
          <button type="button" class="button button--ghost" data-action="json-editor#format">Format JSON</button>
          <%= submit_tag "Run dry test" %>
        </div>
      <% end %>

      <%= turbo_frame_tag "dry_run_result" do %>
        <div class="empty-state">
          <p>No dry-run yet. Submit a payload to inspect the current policy behavior.</p>
        </div>
      <% end %>
    </section>
  </div>
<% end %>
