# Database
DB_HOST=localhost
DB_PORT=5432
# DB_USERNAME=
# DB_PASSWORD=
DB_NAME=netra_development

# Database - Test (optional, defaults work out of box)
# DB_HOST_TEST=localhost
# DB_PORT_TEST=5432
# DB_USERNAME_TEST=
# DB_PASSWORD_TEST=
# DB_NAME_TEST=netra_test

# Rails
RAILS_ENV=development
SECRET_KEY_BASE=change_me_in_production
SEED_DB=true

# Apartment / tenant routing
# NETRA_ALLOWED_ORIGINS=http://localhost:8080

# Active Record Encryption (generate with: bin/rails db:encryption:init)
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# Devise JWT
# DEVISE_JWT_SECRET_KEY=

# Frontend
VITE_API_BASE_URL=http://localhost:3000
